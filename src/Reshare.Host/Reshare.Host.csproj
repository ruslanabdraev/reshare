<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>reshare-host</AssemblyName>
    <RootNamespace>Reshare.Host</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- served from AppContext.BaseDirectory, so it must be next to the exe in build output too -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reshare.Core\Reshare.Core.csproj" />
    <ProjectReference Include="..\Reshare.Platform.Windows\Reshare.Platform.Windows.csproj" />
    <ProjectReference Include="..\Reshare.Platform.MacOS\Reshare.Platform.MacOS.csproj" />
    <ProjectReference Include="..\Reshare.Platform.Linux\Reshare.Platform.Linux.csproj" />
  </ItemGroup>
</Project>
